""""""""""""""""""""""
" obsidian binds
""""""""""""""""""""""
 " unmap space
unmap <Space>  
exmap finder obcommand switcher:open
exmap search obcommand global-search:open
exmap netrw obcommand app:toggle-left-sidebar

nmap <Space>f :finder<CR>
nmap <Space>s :search<CR>
nmap <Space>v :netrw<CR>

nmap <Space>pf :finder<CR>
nmap <Space>ps :search<CR>
nmap <Space>pv :netrw<CR>

""""""""""""""""""""""
" Random
""""""""""""""""""""""

" " move highlighted text
" vmap J :m '>+1<CR>gv=gv
" vmap K :m '<-2<CR>gv=gv

unmap n
nmap nl o<Esc>
nmap Nl O<Esc>
nmap NL O<Esc>

" indent selected block without exiting visual mode
vmap < <gv
vmap > >gv
""""""""""""""""""""""
" General
""""""""""""""""""""""
" Show a few lines of context around the cursor. Note that this makes the
" text scroll if you mouse-click near the start or end of the window.
" set scrolloff=8

" Do incremental searching.
" set incsearch
set tabstop=4

" set relativenumber
" set number
" set commentary

" Don't use Q
" unmap Q

unmap <C-d> " in obsidian this deletes a line for some reason

" exit insert
imap <C-c> <Esc>

""""""""""""""""""""""
" Clipboard
""""""""""""""""""""""
yank to system clipboard
set clipboard=unnamed

" Y consistent with D and C to the end of line
nmap Y y$

" don't pollute the register (HACK since we can't map to `"_x` or `"_C`)
nmap C "_c$
nmap x "_dl

"paste without changing clipboard
nmap <Space>p "_dP

"deleting to void register
vmap <Space>d "_d


""""""""""""""""""""""
" Navigation
""""""""""""""""""""""

" navigate visual lines rather than logical ones (specific for obsidian)
nmap j gj
nmap k gk
nmap I g0i
nmap A g$a

" navigate visual lines rather than logical ones (specific for obsidian)
vmap j gj
vmap k gk
vmap gj j
vmap gk k

" half page jumping tweak
" nmap <C-d> <C-d>zz
" nmap <C-u> <C-u>zz

